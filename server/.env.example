# Site name shown in the browser tab and used in meta tags
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public address of this site. Also used in sitemap.xml and canonical links, so set the real https:// domain in production.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Realtime plane (see /realtime). Both secrets must match the Go services. Empty = realtime disabled.
RT_JWT_SECRET=
RT_INTERNAL_SECRET=
RT_INGEST_URL=http://localhost:8081
RT_INGEST_INTERNAL_URL=http://localhost:8081
RT_HUB_URL=ws://localhost:8082
RT_RECORD_URL=http://localhost:8083
# What THIS server calls to reach the recorder (inside Docker this is the container name, e.g. http://record:8083).
RT_RECORD_INTERNAL_URL=http://localhost:8083
# wss:// address the browser and the candidate app connect to for camera/screen streaming
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- AI services (run outside this app, e.g. on a GPU machine).
# These URLs are only the DEFAULTS. A Root Admin can change them in Admin > System status > Service addresses
# (stored in the database, no redeploy). The token is a secret, so it can only be set here.
# false while no AI worker is deployed (otherwise exams with face monitoring refuse to start)
AI_ENFORCE=true
# face verification
AI_FACE_URL=http://localhost:8090
# prohibited-object detection
AI_OBJECT_URL=http://localhost:8091
# supervisor agent that watches the cameras in real time
AI_AGENT_URL=http://localhost:8099
# shared secret the AI services expect
AI_TOKEN=
# Legacy single worker serving both face and objects; used only when the three URLs above are empty.
# AI_WORKER_URL=
# Seconds to wait for an AI answer before treating the service as unavailable.
AI_WORKER_TIMEOUT=2.0
# Candidates must accept the biometric-processing notice at every login (set false only in tests).
BIOMETRIC_CONSENT_REQUIRED=true

# Hosts allowed to use cookie-based API login (comma separated). Defaults to localhost; set your public domain in production.
# SANCTUM_STATEFUL_DOMAINS=foxyexam.example.edu.vn

# Interactive API documentation at /docs/api. Defaults to APP_DEBUG; set false to hide it in production.
# SCRAMBLE_DEV_TOOLS=false

# Error reporting (optional, free tier is enough). Leave empty to disable.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
