# Caddyfile - FoxyExam Gateway for VPS
{
    email admin@foxyexam.com
    admin 0.0.0.0:2019 # Admin API for remote dynamic routing
}

# Domain chính của nền tảng SaaS
{$APP_DOMAIN:foxyexam.com}, www.{$APP_DOMAIN:foxyexam.com} {
    encode gzip zstd

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }

    # Static files and Laravel Web / API Reverse Proxy
    reverse_proxy app:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Hỗ trợ Wildcard Subdomain cho các trường (vd: hcmus.foxyexam.com)
*.{$APP_DOMAIN:foxyexam.com} {
    encode gzip zstd

    reverse_proxy app:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
