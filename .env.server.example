# =============================================================================
# FOXY EXAM - VPS DEPLOYMENT ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy file này thành .env hoặc .env.vps:
# cp .env.vps.example .env
# docker compose -f docker-compose.vps.yml up -d --build
# =============================================================================

# Domain & Ports
APP_DOMAIN=foxyexam.com
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# Laravel Core Secrets
# Tạo key: docker compose -f docker-compose.vps.yml run --rm app php artisan key:generate --show
APP_KEY=base64:H8pD7Xk+Uu8r7V9h8pD7Xk+Uu8r7V9h8pD7Xk+Uu8r4=
APP_DEBUG=false

# PostgreSQL Credentials
DB_DATABASE=foxy_core
DB_USERNAME=foxy_user
DB_PASSWORD=foxy_vps_secure_password_2026

# AI Worker Connection (Chạy từ Laptop qua Cloudflare Tunnel / Ngrok)
# Để trống nếu AI Worker chưa bật; Hệ thống sẽ tự động chuyển sang chế độ OFFLINE
# và chặn thí sinh vào các kỳ thi có yêu cầu giám sát khuôn mặt (ai_face_check).
AI_WORKER_URL=https://ai-tunnel.foxyexam.com
AI_WORKER_TIMEOUT=2

# LiveKit WebRTC Configuration
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
