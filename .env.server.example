# Nothing is required: Coolify generates secrets and domains. Optional overrides:
#   secrets   Coolify generates SERVICE_PASSWORD_* (Postgres, RT_JWT, RT_INTERNAL, LiveKit, S3) and SERVICE_USER_S3 on first deploy
#   domains   Coolify assigns SERVICE_FQDN_* to gateway (80), livekit (7880) and s3 (9000); edit them in the UI

# Laravel key (32 bytes, "base64:" + base64). Leave empty to use a key generated once and kept on the storage volume.
# Change it only together with the sessions: existing logins stop working.
APP_KEY=

# optional overrides
APP_DEBUG=false
DB_DATABASE=foxy_core
DB_USERNAME=foxy
S3_BUCKET=foxy-records
RECORD_RETENTION_DAYS=0
INGEST_RATE_PER_SEC=5
INGEST_BURST=20
INGEST_SHED_INFLIGHT=2000
HUB_OFFLINE_AFTER=20s
WORKER_BATCH=500
# --- AI services (run outside this stack, e.g. on a GPU machine). Leave empty if there is none yet.
# These are only the DEFAULT addresses: a Root Admin can change them later in Admin > System status > Service addresses
# without redeploying. The token is a secret and can only be set here.
# face verification, e.g. https://ai-face.example.edu.vn
AI_FACE_URL=
# prohibited-object detection
AI_OBJECT_URL=
# supervisor agent that watches the cameras in real time
AI_AGENT_URL=
# shared secret the AI services expect
AI_TOKEN=
# legacy: one worker that does both face and objects (used only when the three above are empty)
AI_WORKER_URL=
# seconds to wait for an AI answer before treating it as unavailable
AI_WORKER_TIMEOUT=2
# false = an offline AI service does not stop candidates from starting an exam
AI_ENFORCE=false
RUN_SEED=true
