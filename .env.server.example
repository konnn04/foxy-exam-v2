# Nothing is required: Coolify generates secrets and domains. Optional overrides:
#   secrets   Coolify generates SERVICE_PASSWORD_* (Postgres, RT_JWT, RT_INTERNAL, LiveKit, S3) and SERVICE_USER_S3 on first deploy
#   domains   Coolify assigns SERVICE_FQDN_* to gateway (80), livekit (7880) and s3 (9000); edit them in the UI

# Laravel key (32 bytes, "base64:" + base64). Leave empty to use a key generated once and kept on the storage volume.
# Change it only together with the sessions: existing logins stop working.
APP_KEY=

# optional overrides
APP_DEBUG=false
DB_DATABASE=foxy_core
DB_USERNAME=foxy
S3_BUCKET=foxy-records
RECORD_RETENTION_DAYS=0
INGEST_RATE_PER_SEC=5
INGEST_BURST=20
INGEST_SHED_INFLIGHT=2000
HUB_OFFLINE_AFTER=20s
WORKER_BATCH=500
AI_WORKER_URL=
AI_WORKER_TIMEOUT=2
AI_ENFORCE=false
RUN_SEED=true

# LiveKit media behind a UDP tunnel (playit.gg): listen on the tunnel's public port and advertise its IP
LIVEKIT_UDP_PORT=7882
LIVEKIT_EXTERNAL_IP=true
LIVEKIT_NODE_IP=
