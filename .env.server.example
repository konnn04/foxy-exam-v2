# =============================================================================
# FoxyExam SERVER stack — environment (Coolify: paste into the "Environment variables" tab)
# Compose file: docker.compose.server.yml        (client apps are NOT part of it)
# Local test:   cp .env.server.example .env.server && docker compose -f docker.compose.server.yml --env-file .env.server up -d --build
#
# Generate secrets on Linux:  openssl rand -hex 32
# Avoid  @ : / ? #  in DB_PASSWORD (it is embedded in a postgres:// URL).
# =============================================================================

# --- domains (create DNS A records for all three -> the VPS public IP)
#   https://APP_DOMAIN       -> gateway :80   (web portal, /api, /rt/*)
#   https://lk.APP_DOMAIN    -> livekit :7880
#   https://s3.APP_DOMAIN    -> minio   :9000
APP_DOMAIN=foxyexam.com

# --- core (Laravel)
# php artisan key:generate --show   (or:  echo "base64:$(openssl rand -base64 32)")
APP_KEY=
APP_DEBUG=false
DB_DATABASE=foxy_core
DB_USERNAME=foxy
DB_PASSWORD=

# --- realtime plane: both secrets are shared by the app and the Go services
RT_JWT_SECRET=
RT_INTERNAL_SECRET=
INGEST_RATE_PER_SEC=5
INGEST_BURST=20
INGEST_SHED_INFLIGHT=2000
HUB_OFFLINE_AFTER=20s
WORKER_BATCH=500

# --- LiveKit (api key is fixed to "foxy" in the stack; only the secret is configurable)
LIVEKIT_API_SECRET=

# --- object storage (MinIO root user/password double as the S3 access/secret key)
S3_ACCESS_KEY=foxyminio
S3_SECRET_KEY=
S3_BUCKET=foxy-records
# delete recordings after N days (0 = keep forever)
RECORD_RETENTION_DAYS=0

# --- AI worker (optional, not part of this stack yet)
AI_WORKER_URL=
AI_WORKER_TIMEOUT=2
# keep false until an AI worker is deployed, otherwise exams with face monitoring refuse to start
AI_ENFORCE=false
