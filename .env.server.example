# Variables to set in Coolify (Environment variables tab). Everything else is generated or derived:
#   secrets   Coolify generates SERVICE_PASSWORD_* (Postgres, RT_JWT, RT_INTERNAL, LiveKit, MinIO) on first deploy
#   domains   Coolify assigns SERVICE_FQDN_* to gateway (80), livekit (7880) and minio (9000); edit them in the UI

# php artisan key:generate --show   (or: echo "base64:$(openssl rand -base64 32)")
APP_KEY=

# optional overrides
APP_DEBUG=false
DB_DATABASE=foxy_core
DB_USERNAME=foxy
S3_ACCESS_KEY=foxyminio
S3_BUCKET=foxy-records
RECORD_RETENTION_DAYS=0
INGEST_RATE_PER_SEC=5
INGEST_BURST=20
INGEST_SHED_INFLIGHT=2000
HUB_OFFLINE_AFTER=20s
WORKER_BATCH=500
AI_WORKER_URL=
AI_WORKER_TIMEOUT=2
AI_ENFORCE=false
