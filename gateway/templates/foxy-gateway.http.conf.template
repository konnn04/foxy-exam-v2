upstream ingest_upstream {
    server ${INGEST_HOST};
    keepalive 128;
}

upstream hub_upstream {
    server ${HUB_HOST};
    keepalive 32;
}

upstream record_upstream {
    server ${RECORD_HOST};
    keepalive 16;
}

# upstreams
upstream core_upstream {
    server ${CORE_HOST};
    keepalive 64;
}

upstream reverb_upstream {
    server ${REVERB_HOST};
    keepalive 32;
}

upstream ai_upstream {
    server ${AI_HOST};
    keepalive 16;
}

upstream livekit_upstream {
    server ${LIVEKIT_HOST};
    keepalive 32;
}

# Plain HTTP: TLS is terminated by the platform proxy (Coolify / Traefik) in front of this container.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};
    proxy_read_timeout 120s;
    proxy_connect_timeout 10s;
    proxy_send_timeout 120s;

    location = /gateway-health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok","gateway":"foxy-gateway","tls":"external"}';
    }

    include /etc/nginx/foxy-locations.inc;
}
