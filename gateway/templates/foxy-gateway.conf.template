# ==============================================================================
# 🦊 FOXY EXAM — DYNAMIC SERVICE GATEWAY ROUTING TEMPLATE
# Rendered at container startup via envsubst
# ==============================================================================

# Upstream definitions with keepalive connection pools
upstream core_upstream {
    server ${CORE_HOST};
    keepalive 64;
}

upstream reverb_upstream {
    server ${REVERB_HOST};
    keepalive 32;
}

upstream ai_upstream {
    server ${AI_HOST};
    keepalive 16;
}

upstream livekit_upstream {
    server ${LIVEKIT_HOST};
    keepalive 32;
}

upstream ingest_upstream {
    server ${INGEST_HOST};
    keepalive 128;
}

upstream hub_upstream {
    server ${HUB_HOST};
    keepalive 32;
}

upstream record_upstream {
    server ${RECORD_HOST};
    keepalive 16;
}

# ------------------------------------------------------------------------------
# 1. HTTP Ingress (Port 80) -> HTTPS Redirect with ACME challenge support
# ------------------------------------------------------------------------------
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${SERVER_NAME};

    # Let's Encrypt / Certbot ACME HTTP-01 challenge
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # Lightweight healthcheck over HTTP for load balancers / monitoring
    location = /gateway-health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok","gateway":"nginx","protocol":"http","timestamp":"$time_iso8601"}';
    }

    # Redirect all other HTTP requests to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# ------------------------------------------------------------------------------
# 2. HTTPS Main Gateway (Port 443) -> Multi-Service Reverse Proxy
# ------------------------------------------------------------------------------
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name ${SERVER_NAME};

    # SSL Certificates (Cloudflare Origin, Let's Encrypt, or Auto-generated dev)
    ssl_certificate ${SSL_CERT_PATH};
    ssl_certificate_key ${SSL_KEY_PATH};

    # Modern TLS Security
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Security Headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-XSS-Protection "1; mode=block" always;

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};
    proxy_read_timeout 120s;
    proxy_connect_timeout 10s;
    proxy_send_timeout 120s;

    # Gateway Healthcheck endpoint
    location = /gateway-health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok","gateway":"foxy-gateway","ssl":true,"timestamp":"$time_iso8601"}';
    }

    include /etc/nginx/foxy-locations.inc;
}
