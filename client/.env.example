# FoxyClient (Tauri) build/dev configuration — copy to .env.development.local / .env.production

# Core API. Dev default: http://127.0.0.1:8000/api/v1 (php artisan serve)
# Production: the public origin of the server stack, e.g. https://foxyexam.com/api/v1
VITE_API_BASE_URL=

# --- DEV ONLY (ignored by production builds, which hard-disable every bypass) -------------------
# Bypass the proctoring checks while testing: all | csv of
#   setup     skip the pre-exam device check ("lobby") and go straight in
#   camera    no camera needed / published
#   screen    no screen sharing needed
#   devices   ignore extra monitors, banned apps (OBS...), external keyboards
#   realtime  do not use the realtime plane, use the plain REST endpoints
#   network   continue although the server health check failed
# The same switches are available at runtime from the floating "DEV" button in the lobby and exam windows.
VITE_FOXY_DEV_BYPASS=
